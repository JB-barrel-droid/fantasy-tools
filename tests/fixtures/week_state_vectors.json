{
  "about": "JEG-1177: shared vectors for the week-transition rule. pipelines/week_state.py (Python) and value-model.js weekState/defaultWeek (JS) must both return `expect` for every case. A case gives `entries` ([{source, week}]) or `counts` ({week or \"null\": n}); counts expand to sources s000, s001, ... in the order the keys are listed. `expect` lists only the fields checked; views are checked when given. Rule (Jeremy, 2026-10-27, JEG-1176): default to N+1 only when MORE than 50% of a setting's DDF Value sources serve it; exactly 50% stays on N.",
  "cases": [
    {"name": "0% on N+1: every source still on week 7 (no transition)",
     "counts": {"7": 7},
     "expect": {"newest": 7, "default_week": 7, "transition": false, "weeks": [7], "on_newest": 7, "total": 7}},
    {"name": "0% on N+1 among 100",
     "counts": {"7": 100},
     "expect": {"newest": 7, "default_week": 7, "transition": false, "on_newest": 100, "total": 100}},
    {"name": "49% on N+1",
     "counts": {"8": 49, "7": 51},
     "expect": {"newest": 8, "previous": 7, "default_week": 7, "transition": true, "weeks": [8, 7], "on_newest": 49, "total": 100}},
    {"name": "50% on N+1 stays on N",
     "counts": {"8": 50, "7": 50},
     "expect": {"newest": 8, "default_week": 7, "transition": true, "on_newest": 50, "total": 100}},
    {"name": "51% on N+1",
     "counts": {"8": 51, "7": 49},
     "expect": {"newest": 8, "default_week": 8, "transition": true, "on_newest": 51, "total": 100}},
    {"name": "100% on N+1",
     "counts": {"8": 100},
     "expect": {"newest": 8, "default_week": 8, "transition": false, "weeks": [8], "on_newest": 100, "total": 100}},
    {"name": "JEG-1178: 40% on N+1 (2 of 5) stays on N",
     "counts": {"8": 2, "7": 3},
     "expect": {"newest": 8, "previous": 7, "default_week": 7, "transition": true, "weeks": [8, 7], "on_newest": 2, "total": 5}},
    {"name": "JEG-1178: 60% on N+1 (3 of 5) moves to N+1",
     "counts": {"8": 3, "7": 2},
     "expect": {"newest": 8, "previous": 7, "default_week": 8, "transition": true, "weeks": [8, 7], "on_newest": 3, "total": 5}},
    {"name": "exactly half of an even set (1 of 2) stays on N",
     "entries": [{"source": "cbs", "week": 8}, {"source": "usatoday", "week": 7}],
     "expect": {"default_week": 7, "transition": true}},
    {"name": "week 8 run 40555873437 (2026-10-27): 4 of 7 on week 8",
     "entries": [{"source": "usatoday", "week": 7}, {"source": "fantasycalc", "week": 8},
                 {"source": "fantasypros", "week": 8}, {"source": "cbs", "week": 7},
                 {"source": "espn", "week": 8}, {"source": "cbsros", "week": 8},
                 {"source": "razzball", "week": 7}],
     "expect": {"newest": 8, "previous": 7, "default_week": 8, "transition": true, "weeks": [8, 7],
                "on_newest": 4, "total": 7,
                "views": {"8": {"sources": ["cbsros", "espn", "fantasycalc", "fantasypros"],
                                "missing_sources": ["cbs", "razzball", "usatoday"]},
                          "7": {"sources": ["cbs", "cbsros", "espn", "fantasycalc", "fantasypros", "razzball", "usatoday"],
                                "missing_sources": []}}}},
    {"name": "3 of 7 on week 8 defaults to week 7",
     "entries": [{"source": "usatoday", "week": 7}, {"source": "fantasycalc", "week": 8},
                 {"source": "fantasypros", "week": 7}, {"source": "cbs", "week": 7},
                 {"source": "espn", "week": 8}, {"source": "cbsros", "week": 8},
                 {"source": "razzball", "week": 7}],
     "expect": {"default_week": 7, "on_newest": 3, "total": 7}},
    {"name": "a source with no known week counts in the total and is missing from both views",
     "entries": [{"source": "a", "week": 8}, {"source": "b", "week": 8}, {"source": "c", "week": null}, {"source": "d", "week": 7}],
     "expect": {"default_week": 7, "on_newest": 2, "total": 4,
                "views": {"8": {"sources": ["a", "b"], "missing_sources": ["c", "d"]},
                          "7": {"sources": ["a", "b", "d"], "missing_sources": ["c"]}}}},
    {"name": "a source two weeks behind is missing from both views",
     "entries": [{"source": "a", "week": 8}, {"source": "b", "week": 8}, {"source": "c", "week": 6}],
     "expect": {"default_week": 8, "transition": true,
                "views": {"8": {"sources": ["a", "b"], "missing_sources": ["c"]},
                          "7": {"sources": ["a", "b"], "missing_sources": ["c"]}}}},
    {"name": "duplicate source entries count once",
     "entries": [{"source": "a", "week": 8}, {"source": "a", "week": 8}, {"source": "b", "week": 7}],
     "expect": {"default_week": 7, "on_newest": 1, "total": 2}},
    {"name": "no source has a week",
     "entries": [{"source": "a", "week": null}],
     "expect": {"newest": null, "default_week": null, "transition": false, "weeks": [], "total": 1, "views": {}}},
    {"name": "no sources",
     "entries": [],
     "expect": {"newest": null, "default_week": null, "transition": false, "weeks": [], "total": 0, "views": {}}},
    {"name": "JEG-1176: week 8 to 9 at 0%", "counts": {"8": 100}, "expect": {"default_week": 8, "total": 100}},
    {"name": "JEG-1176: week 8 to 9 at 49%", "counts": {"9": 49, "8": 50, "null": 1}, "expect": {"default_week": 8, "total": 100}},
    {"name": "JEG-1176: week 8 to 9 at 50%", "counts": {"9": 50, "8": 49, "null": 1}, "expect": {"default_week": 8, "total": 100}},
    {"name": "JEG-1176: week 8 to 9 at 51%", "counts": {"9": 51, "8": 48, "null": 1}, "expect": {"default_week": 9, "total": 100}},
    {"name": "JEG-1176: week 8 to 9 at 100%", "counts": {"9": 100}, "expect": {"default_week": 9, "total": 100}}
  ]
}
