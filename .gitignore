output/
# The bench-decay evidence matrix is committed: memo.md cites it and --check diffs it (JEG-1302).
!docs/research/bench-decay-evidence/output/
.playwright-mcp/

# Watchdog runtime state (regenerated every run; never committed).
ops/watchdog/health.json
ops/watchdog/pulls/
.gitstore/
*.log

# Local data exports and credentials must not be committed.
data/raw/
data/private/
secrets/
*.key
*.pem

# CI-only browser gate dependency (JEG-47); installed with npm ci.
tests/rendered_gate/node_modules/

# JEG-424: built by make sync on every deploy (8MB, changes every bake)
dist/consolidated-values.json
.claude/worktrees/

# v2 page: generated by make sync (pipelines/build_v2_page.py) on every deploy.
dist/v2/
dist/classic/
# JEG-1534 preview of the redesigned pages: generated from app/next/ by make sync.
dist/next/
# JEG-1535: swapped redesign pages and their shared files, generated at the root by pipelines/build_root_pages.py.
/dist/values.html
/dist/site.js
/dist/styles.css
/dist/players-table-1.json
/dist/ddf-engine.js
/dist/values-*.js
# JEG-1537: Build a Trade at the root.
/dist/build.html
/dist/build-trade.js
/dist/build-offer.js
/dist/tradechart.js
/dist/tradechart.css
/dist/assets/howto/
/dist/learn.html
/dist/learn/
# JEG-1538: entry pages and their files at the root.
/dist/connect.html
/dist/setup.html
/dist/rosterparse.js
/dist/league-paste.js
/dist/connect-entry.js
/dist/setup-entry.js
/dist/actionbar.js
/dist/actionbar.css
/dist/img/

# Math inspector (internal): generated by make sync (pipelines/build_inspector_page.py).
dist/modules/math-inspector.html
dist/modules/math-inspector.js
dist/modules/math-inspector.css

# Week history: data/history/ is the committed store; make sync copies it
# beside the page (and rebuilds its index) on every deploy.
app/trade-value-chart/assets/history/
dist/assets/history/

# Test build artifacts (esbuild transpiles TS for node tests)
tests/node/.viability_build/
tests/node/.fit_build/

# Trusted incident observer coordination (no secrets)
.incident-reader-locks/
