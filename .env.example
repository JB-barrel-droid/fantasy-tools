# Copy to .env for local development. Do not commit real values.

# Supabase should start read-only in this migration.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional overrides for the finished fixture artifacts. These default to the
# committed fixtures; app/trade-value-chart/ holds generated copies, and the
# players payload is inlined into index.html by `make sync`, so point these at
# data/fixtures/current/ rather than at anything under app/.
TRADE_VALUE_PLAYERS_JSON=data/fixtures/current/players.json
TRADE_VALUE_COMPARISON_SOURCES_JSON=data/fixtures/current/comparison-sources-data.json

