{
  "schema": "ddf-surfaces-v1",
  "about": "Every surface that connects a backend artifact to a published page (JEG-424). Read by modules/status.html (live, in the browser) and tests/test_published_surfaces.py (at build time, inside make validate). url is relative to the site root.",
  "surfaces": [
    {"id": "chart-fixture", "page": "Trade Value Dashboard", "label": "Comparison sources (chart values)",
     "url": "assets/comparison-sources-data.json", "backend": "rebuild chain -> data/fixtures/current -> make sync",
     "count_path": "sources", "min_count": 5, "time_field": "built_at", "max_age_hours": 192, "required": true,
     "meaning": "parses, at least 5 sources, fixture built within 8 days"},
    {"id": "player-news", "page": "Trade Value Dashboard", "label": "Player news",
     "url": "assets/player-news.json", "backend": "player-news pipeline -> make sync",
     "count_path": "news_by_player_key", "min_count": 1, "required": true,
     "meaning": "parses, at least one player with news"},
    {"id": "reference-freshness", "page": "Trade Value Dashboard + Monitor", "label": "Reference freshness",
     "url": "assets/reference-freshness.json", "backend": "check_reference_freshness.py -> make sync",
     "count_path": "items", "min_count": 1, "time_field": "generated_at", "max_age_hours": 24, "required": true,
     "meaning": "parses, at least one item, generated within 24h"},
    {"id": "consolidation", "page": "Consolidation watcher", "label": "Consolidated values export",
     "url": "consolidated-values.json", "backend": "make sync (build_consolidated_values reconciliation) from the validated fixture",
     "count_path": "rows", "min_count": 1000, "time_field": "generated_at", "max_age_hours": 192, "required": true,
     "meaning": "parses, at least 1,000 rows, built within 8 days"},
    {"id": "import-health", "page": "Monitor", "label": "Source import health",
     "url": "modules/source-import-health.json", "backend": "health-artifacts.yml (Supabase import + verify)",
     "count_path": "sources", "min_count": 7, "time_field": "checked_at", "max_age_hours": 1, "required": true,
     "meaning": "parses, all 7 sources present, checked within 60 min"},
    {"id": "pipeline-checkpoints", "page": "Monitor", "label": "Pipeline checkpoints",
     "url": "modules/pipeline-checkpoints.json", "backend": "health-artifacts.yml",
     "count_path": "checkpoints", "min_count": 1, "time_field": "generated_at", "max_age_hours": 1, "required": true,
     "meaning": "parses, checkpoints present, generated within 60 min"},
    {"id": "monitoring-summary", "page": "Monitor", "label": "Is everything working? (Supabase check observations)",
     "url": "modules/monitoring-summary.json", "backend": "health-artifacts.yml -> public.monitoring_summary() over monitoring.check_observations",
     "count_path": "checks", "min_count": 0, "time_field": "generated_at", "max_age_hours": 1, "required": true,
     "meaning": "parses and was snapshotted within 60 min; the file is red on its own when Supabase could not be read (the banner, not this row, carries pass/fail)"},
    {"id": "chain-status", "page": "Monitor", "label": "Comparison chain status",
     "url": "modules/comparison-chain-status.json", "backend": "rebuild-chain.yml (pg_cron every 6h)",
     "count_path": "sources", "min_count": 1, "time_field": "run_at", "max_age_hours": 7, "required": true,
     "meaning": "parses, a chain run recorded within 7h"},
    {"id": "github-actions", "page": "Monitor", "label": "GitHub Actions status",
     "url": "modules/github-actions.json", "backend": "build_github_actions_status.py (rebuild chain)",
     "count_path": "workflows", "min_count": 1, "time_field": "generated_at", "max_age_hours": 7, "required": true,
     "meaning": "parses, workflows listed, generated within 7h"},
    {"id": "vorp-view", "page": "Monitor", "label": "VORP vs waivers view",
     "url": "modules/vorp-view.json", "backend": "make sync", "count_path": "sources", "min_count": 1,
     "time_field": "generated_at", "max_age_hours": 192, "required": true, "meaning": "parses, sources present"},
    {"id": "adj-view", "page": "Monitor", "label": "Adjusted values view",
     "url": "modules/adj-view.json", "backend": "make sync", "count_path": "sources", "min_count": 1,
     "time_field": "generated_at", "max_age_hours": 192, "required": true, "meaning": "parses, sources present"},
    {"id": "ddf-groups", "page": "Monitor", "label": "8-group totals",
     "url": "modules/ddf-group-vorps.json", "backend": "make sync (latest DDF leg)", "count_path": "groups", "min_count": 8,
     "time_field": "source_generated_at", "max_age_hours": 192, "required": true,
     "meaning": "parses, all 8 groups, source leg within 8 days"},
    {"id": "player-trace", "page": "Monitor", "label": "Player trace",
     "url": "modules/player-trace.json", "backend": "player-trace-rebuild.yml (pg_cron every 6h)",
     "count_path": "players", "min_count": 1, "time_field": "generated_at", "max_age_hours": 13, "required": true,
     "meaning": "parses, players present, generated within 13h"},
    {"id": "source-fidelity", "page": "Monitor", "label": "Source fidelity",
     "url": "modules/source-fidelity.json", "backend": "build_source_fidelity.py", "count_path": "sources", "min_count": 1,
     "time_field": "generated_at", "max_age_hours": 192, "required": true, "meaning": "parses, generated within 8 days"},
    {"id": "source-value-lineage", "page": "Monitor", "label": "Source value lineage",
     "url": "modules/source-value-lineage.json", "backend": "build_source_value_lineage.py", "count_path": "sources", "min_count": 1,
     "time_field": "generated_at", "max_age_hours": 192, "required": true, "meaning": "parses, generated within 8 days"},
    {"id": "index-math", "page": "Monitor", "label": "Index math",
     "url": "modules/index-math.json", "backend": "build_index_math.py", "count_path": "sources", "min_count": 1,
     "time_field": "generated_at", "max_age_hours": 192, "required": true, "meaning": "parses, generated within 8 days"},
    {"id": "scale-agreement", "page": "Monitor", "label": "Scale agreement",
     "url": "modules/scale-agreement.json", "backend": "scale agreement builder", "count_path": "sources", "min_count": 1,
     "time_field": "generated_at", "max_age_hours": 192, "required": true, "meaning": "parses, generated within 8 days"},
    {"id": "cross-source-agreement", "page": "Monitor", "label": "Cross-source agreement",
     "url": "modules/cross-source-agreement.json", "backend": "cross-source agreement builder", "count_path": "sources_compared", "min_count": 1,
     "time_field": "generated_at", "max_age_hours": 192, "required": true, "meaning": "parses, generated within 8 days"},
    {"id": "chart-input-coverage", "page": "Monitor", "label": "Chart input coverage",
     "url": "modules/chart-input-coverage.json", "backend": "chart input coverage builder", "count_path": "items", "min_count": 1,
     "time_field": "generated_at", "max_age_hours": 192, "required": true, "meaning": "parses, generated within 8 days"},
    {"id": "e2e-fidelity", "page": "Monitor", "label": "End-to-end fidelity (JEG-77 card)",
     "url": "modules/e2e-fidelity.json", "backend": "build_e2e_fidelity.py (no scheduled producer)", "count_path": "sources", "min_count": 1,
     "time_field": "generated_at", "max_age_hours": 192, "required": false,
     "known_gap": "No workflow produces this file, so the card never loads on the live site (found 2026-10-05).",
     "meaning": "parses, generated within 8 days"}
  ]
}
