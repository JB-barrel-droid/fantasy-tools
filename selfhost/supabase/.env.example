# Self-hosted data store (JEG-792). Copy is made by:
#   python3 gen-keys.py --write .env
# which fills every <generated> value below and sets the file to mode 600.
# Never commit .env (the repo .gitignore and selfhost/supabase/.gitignore
# both exclude it).

# --- Postgres -------------------------------------------------------------
# Password for supabase_admin, postgres and authenticator (PostgREST login).
POSTGRES_PASSWORD=<generated>

# --- JWT ------------------------------------------------------------------
# HS256 secret PostgREST and the function router verify tokens with.
JWT_SECRET=<generated>
# Long-lived HS256 JWTs signed with JWT_SECRET (role claim anon / service_role).
ANON_KEY=<generated>
SERVICE_ROLE_KEY=<generated>

# --- PostgREST ------------------------------------------------------------
# Schemas served under /rest/v1. The pipelines use public, and api via
# Accept-Profile/Content-Profile. Match the cloud dashboard's
# "Exposed schemas" if it lists more.
PGRST_DB_SCHEMAS=public,api
# Same 1000-row cap as the cloud (gh_sbclient.get_all pages past it).
PGRST_DB_MAX_ROWS=1000

# --- Gateway --------------------------------------------------------------
# Keep 127.0.0.1. Exposing the Mac goes through the tunnel profile or a
# self-hosted runner, never 0.0.0.0 (docs/selfhost-supabase.md).
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8000

# --- relay profile (edge runtime) ------------------------------------------
# Optional override for get-values; empty uses its built-in Pages URL.
DDF_SITE_ORIGIN=

# --- tunnel profile (cloudflared) ------------------------------------------
# Token from Cloudflare Zero Trust > Networks > Tunnels. Leave empty unless
# you run `--profile tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=

# --- backup.sh ------------------------------------------------------------
# Where nightly dumps go (absolute path; empty = ~/ddf-supabase-backups)
# and how many days to keep.
BACKUP_DIR=
BACKUP_KEEP_DAYS=14
