# Gateway for the self-hosted stack (JEG-792). Rendered by the nginx image's
# envsubst step; only ANON_KEY and SERVICE_ROLE_KEY are substituted
# (NGINX_ENVSUBST_FILTER in docker-compose.yml). Everything with a lowercase
# $name below is an nginx variable.
#
# It does what the cloud's gateway does for the paths the pipelines use:
#   /rest/v1/<path>      -> PostgREST /<path>, only with a known apikey
#   /rest/v1/ (root)     -> PostgREST OpenAPI root, service key only
#   /functions/v1/<fn>   -> edge runtime (relay profile); the router there
#                           verifies JWTs per function
# Anything else is 404.

# Docker's embedded DNS, so nginx starts even when the optional
# `functions` service is not running (that route then answers 502).
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_apikey $ddf_key_role {
    default                 "";
    "${ANON_KEY}"           anon;
    "${SERVICE_ROLE_KEY}"   service_role;
}

# Like the cloud gateway: with no Authorization header, the apikey is the bearer.
map $http_authorization $ddf_auth {
    ""      "Bearer $http_apikey";
    default $http_authorization;
}

server {
    listen 8000;
    server_tokens off;
    default_type application/json;
    client_max_body_size 50m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location = /gateway-health {
        access_log off;
        return 200 '{"ok":true}';
    }

    location = /rest/v1/ {
        if ($ddf_key_role != "service_role") {
            return 401 '{"message":"service key required"}';
        }
        set $rest_upstream rest:3000;
        proxy_set_header Authorization $ddf_auth;
        proxy_read_timeout 120s;
        proxy_pass http://$rest_upstream/;
    }

    location /rest/v1/ {
        if ($ddf_key_role = "") {
            return 401 '{"message":"Invalid API key"}';
        }
        set $rest_upstream rest:3000;
        rewrite ^/rest/v1/(.*)$ /$1 break;
        proxy_set_header Authorization $ddf_auth;
        proxy_read_timeout 120s;
        proxy_pass http://$rest_upstream;
    }

    location /functions/v1/ {
        set $fn_upstream functions:9000;
        rewrite ^/functions/v1/(.*)$ /$1 break;
        proxy_read_timeout 160s;
        proxy_pass http://$fn_upstream;
    }

    location / {
        return 404 '{"message":"not found"}';
    }
}
