 "gaps": [
  {
   "effect": "No sample count or confidence interval for the option-value decay curve.",
   "id": "G1",
   "owner": "post 1 research script (JEG-544 lane)",
   "what": "The breakout-by-week series stores rates without cohort sizes or breakout counts."
  },
  {
   "effect": "The scoring of the option-value series differs from its label, and a blank score is read as 0.",
   "id": "G2",
   "owner": "post 1 research script (JEG-544 lane)",
   "what": "tools/research/bench_value_by_week.py and breakout_rate.py score breakouts with half_ppr, falling back to std, then 0, though the actuals file has a ppr column and the by-week artifact is labelled ppr."
  },
  {
   "effect": "A player who scores like a starter for the weeks left but not for the season is not counted, so part of the late fall comes from the target definition, not runway alone.",
   "id": "G3",
   "owner": "post 1 research script (JEG-544 lane)",
   "what": "A breakout is defined by full-season points per game, which includes the weeks before the measure week."
  },
  {
   "effect": "The weeks-left axis is approximate for half the seasons.",
   "id": "G4",
   "owner": "post 1 research script (JEG-544 lane)",
   "what": "weeks_remaining in the breakout series is 17 minus the measure week for every season, though 2021-2025 have 18 weeks."
  },
  {
   "effect": "The by-week rates (1-6%) are not on the same scale as the by-depth rates (2-27%).",
   "id": "G5",
   "owner": "post 1 research script (JEG-544 lane)",
   "what": "The breakout cohort is every non-starter with a game log, not rostered bench players."
  },
  {
   "effect": "No measured basis for a per-week discount (JEG-528 item 2); its Done-when is unmet.",
   "id": "G6",
   "owner": "JEG-943 / JEG-944 storage",
   "what": "No week-ahead projections are stored by lead time; the JEG-943 backtest compares rest-of-season projections with single weeks over 5 weeks."
  },
  {
   "effect": "No measured option-value decay on the engine itself.",
   "id": "G7",
   "owner": "JEG-530 series",
   "what": "Option value (#604 optionValue) and starter-vs-bench risk exist only as one snapshot, not by content week."
  },
  {
   "effect": "The two published numbers come from different engine states or definitions; which one holds today is unchecked.",
   "id": "G8",
   "owner": "post 1 (JEG-544)",
   "what": "Post 1's sensitivity table gives 10.0% bench share at PPR/12; the by-week artifact gives 8.7% at week 1 for the same setting."
  },
  {
   "effect": "The model series' content date is bounded by its capture date only, and m has no sample count here.",
   "id": "G9",
   "owner": "post 1 research script; derive_lineup_parameters.py",
   "what": "The engine fixture date behind the by-week model series is not recorded; game counts behind m are not in the config."
  },
  {
   "effect": "The existing timing series is not monotone at the last week; it is a separate series, not DDF Value.",
   "id": "G10",
   "owner": "JEG-528 (#604 series)",
   "what": "At content week 17 the objective window is empty (week 18 to 17), and the #604 timing rule then leaves its factor at 1, so the timing series goes from 1/17 at week 16 back to full at week 17."
  }
 ],
