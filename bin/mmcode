#!/usr/bin/env python3
"""
bin/mmcode — MiniMax lane CLI connector (JEG-94).

Thin wrapper around `python3 -m lanes.protocol`. The connector interface
is `LaneAdapter`; only the minimax adapter is shipped today (see
lanes/ROUTING.md for why).

Subcommands:
  make-brief        Build + sign + write a brief to lanes/outbox/<lane>/
  make-result       Build + sign + write a result to lanes/inbox/<lane>/
  dispatch          Build a brief and run it through the adapter
  verify            Reviewer gate: verify a result against its brief
  adapter-self-test Round-trip the shipped adapter in dry-run mode

The protocol refuses any subcommand whose flags miss a required field.
See lanes/LANES.md for the data model and lanes/ROUTING.md for the
reachability rules.
"""
import sys
from pathlib import Path

# Make lanes/ importable when this script runs from anywhere in the repo.
HERE = Path(__file__).resolve()
REPO_ROOT = HERE.parent.parent
sys.path.insert(0, str(REPO_ROOT))

# Delegate to the protocol module's CLI surface.
from lanes import protocol  # noqa: E402


def _usage(prog_name: str) -> None:
    print(
        f"Usage: {prog_name} <subcommand> [flags]\n"
        "\n"
        "Subcommands:\n"
        "  make-brief        --issue I --lane L --from F --subject S --context C\n"
        "                     [--outbox DIR] [--ts ISO]\n"
        "  make-result       --issue I --lane L --subject S --context C\n"
        "                     [--inbox DIR] [--ts ISO]\n"
        "  dispatch          --issue I --lane L --from F --subject S --context C\n"
        "                     [--inbox DIR] [--ts ISO] [--dry-run]\n"
        "  verify            --brief PATH --result PATH\n"
        "  adapter-self-test [--inbox DIR]\n",
        file=sys.stderr,
    )


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        _usage(sys.argv[0] if sys.argv else "bin/mmcode")
        return 0 if (len(sys.argv) >= 2 and sys.argv[1] in ("-h", "--help", "help")) else 2

    subcommand = sys.argv[1]
    forwarded = [subcommand] + sys.argv[2:]
    return protocol.main(forwarded)


if __name__ == "__main__":
    sys.exit(main())